// OSCER. The scratch, OURdisk and queue names are hardcoded rather than params: they vary by
// site, not by run.

workDir = "/scratch/${System.getenv('USER')}/merfish_testis_work/${params.run_id}"

process {
    executor      = 'slurm'
    queue         = 'normal'
    cpus          = 8
    // Scales with the attempt so a task that died on memory gets more.
    memory        = { 32.GB * task.attempt }
    time          = { 4.h + (task.attempt - 1) * 4.h }
    errorStrategy = 'retry'
    maxRetries    = 3

    withLabel: 'gpu' {
        queue            = 'sooner_gpu_test'
        clusterOptions   = '--gres=gpu:1'
        // CONDA_PREFIX because python_spatial does not export one -- see conf/wsl.config.
        // TMPDIR repeated because this replaces nextflow.config's containerOptions.
        containerOptions = { '--nv' +
            ' --env CONDA_PREFIX=/opt/conda/envs/python_spatial' +
            " --env TMPDIR=${task.workDir}" }
    }
}
apptainer {
    // `env -` drops SLURM's CUDA_VISIBLE_DEVICES, so cupy takes device 0, not the allocated card.
    envWhitelist = 'CUDA_VISIBLE_DEVICES'
    // Scratch's 14-day delete goes by creation time, so a cache there dies every fortnight.
    cacheDir     = '/ourdisk/hpc/lilab/babiddy/dont_archive/apptainer_cache'
    // The GPU image's OCI-to-SIF conversion exceeds the 20m default, killed with exit 143.
    pullTimeout  = '2h'
}

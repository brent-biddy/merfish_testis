// OSCER. Hardcoded scratch, OURdisk and queue names on purpose, so it works there and nowhere
// else -- copying it is how another cluster gets added. States only what differs from
// nextflow.config.

params {
    work_root = "/scratch/${System.getenv('USER')}/merfish_testis_work"
}

// Restated, unlike outdir: nextflow.config interpolates work_root at parse time, before this
// profile is read, so without this line a run here still scratches to the default $HOME path.
workDir = "${params.work_root}/${params.run_id}"

process {
    executor      = 'slurm'
    queue         = 'normal'
    // No container: a site says how to reach a card, not what to run.
    cpus          = 8
    // Scales with the attempt so a task that died on memory gets more.
    memory        = { 32.GB * task.attempt }
    time          = { 4.h + (task.attempt - 1) * 4.h }
    errorStrategy = 'retry'
    maxRetries    = 3

    // TMPDIR is unset inside the container -- the `env -` Nextflow wraps around apptainer
    // drops the job-scoped one SLURM sets -- so scratch would land in the node's shared /tmp.
    containerOptions = { "--env TMPDIR=${task.workDir}" }

    // The merged label raster is ~7 GB a z plane, and the step holds one plane, the counts
    // and the traced polygons at once. The 32 GB default OOMs twice before the retry ladder
    // reaches a size that runs.
    withName: 'PREP_CELLPOSE_VPT' {
        memory = { 64.GB * task.attempt }
        time   = { 8.h + (task.attempt - 1) * 4.h }
    }

    // --gres allocates the card; --nv exposes the driver inside the container. CONDA_PREFIX
    // because python_spatial does not export one -- see conf/wsl.config.
    withLabel: 'gpu' {
        // Any GPU rather than an H100: the step asks for one card and never uses NVlink, so
        // pinning H100 buys 80 GB over 48 while narrowing what can schedule it. A b2_r0 sweep
        // on sooner_gpu_test_h100 pended 71 minutes to run for 7.
        queue            = 'sooner_gpu_test'
        clusterOptions   = '--gres=gpu:1'
        // TMPDIR repeated because this replaces the containerOptions above.
        containerOptions = { '--nv' +
            ' --env CONDA_PREFIX=/opt/conda/envs/python_spatial' +
            " --env TMPDIR=${task.workDir}" }
    }
}
apptainer {
    // `env -` drops the variable SLURM sets to name the allocated GPU. Without it cupy takes
    // device 0 -- possibly another job's card -- and OOMs while the allocated one idles.
    envWhitelist = 'CUDA_VISIBLE_DEVICES'
    // On OURdisk, not work_root: scratch's 14-day delete runs on creation time, so a cache
    // there is dropped every fortnight and pays the conversion below again.
    cacheDir     = '/ourdisk/hpc/lilab/babiddy/dont_archive/apptainer_cache'
    // The GPU image's OCI-to-SIF conversion exceeds the 20m default and is killed mid-way
    // with exit 143. Paid inside the job's wall clock, on a cache miss only.
    pullTimeout  = '2h'
}

// OSCER. Opinionated on purpose: hardcoded scratch, OURdisk and queue names, so it works
// there and nowhere else. That is what makes the collaborator contract one sentence — copy
// this file, change the paths and queue names, add one line to `profiles`.
//
// It states only what differs from the defaults in conf/defaults.config.

params {
    work_root = "/scratch/${System.getenv('USER')}/merfish_testis_work"
    outdir    = "${projectDir}/results/${params.run_id}"
}
workDir = "${params.work_root}/${params.run_id}"
cleanup = true

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }
process {
    executor      = 'slurm'
    queue         = 'normal'
    // No container here: which image a step runs in is universal and lives in
    // conf/defaults.config. A site says how to reach a card, not what to run.
    cpus          = 8
    // Scales with the attempt so a task that died on memory gets more.
    memory        = { 32.GB * task.attempt }
    time          = { 4.h + (task.attempt - 1) * 4.h }
    errorStrategy = 'retry'
    maxRetries    = 3

    // TMPDIR is unset inside the container — the `env -` Nextflow wraps around
    // apptainer drops the job-scoped one SLURM sets — so scratch files land in the
    // node's shared /tmp. Point it at the task's own work dir instead.
    containerOptions = { "--env TMPDIR=${task.workDir}" }

    // The merged label raster is one uint32 array per z plane over the whole
    // mosaic -- about 7 GB a plane, and the step holds one plane, the counts and
    // the traced polygons at once. The 32 GB default OOMs twice before the retry
    // ladder reaches a size that runs, so it is set here instead.
    withName: 'PREP_CELLPOSE_VPT' {
        memory = { 64.GB * task.attempt }
        time   = { 8.h + (task.attempt - 1) * 4.h }
    }

    // --gres is what actually allocates a card; --nv exposes the driver inside the
    // container. CONDA_PREFIX is not set here: cupy finds the CUDA headers under it
    // and the image already points it at its own env, so naming a path here only
    // risks naming the wrong image's.
    withLabel: 'gpu' {
        // Any GPU rather than an H100 specifically. The step asks for one card and
        // never uses NVlink, so pinning H100 buys only its 80 GB over the 48 GB of
        // the Ada and L40S cards in this partition -- while narrowing what can
        // schedule it. A b2_r0 sweep on sooner_gpu_test_h100 pended 71 minutes to
        // run for 7.
        queue            = 'sooner_gpu_test'
        clusterOptions   = '--gres=gpu:1'
        // TMPDIR repeated because this replaces the containerOptions above.
        containerOptions = { '--nv' + " --env TMPDIR=${task.workDir}" }
    }
}
apptainer {
    enabled      = true
    runOptions   = '--writable-tmpfs'
    // Nextflow's launcher wraps apptainer exec in `env -`, which drops the variable
    // SLURM sets to name the allocated GPU. Without it cupy takes device 0, which
    // may be another job's card, and dies out of memory while the allocated one idles.
    envWhitelist = 'CUDA_VISIBLE_DEVICES'
    // On OURdisk rather than under work_root: scratch's 14-day delete runs on
    // creation time, so a cache there is dropped every fortnight and re-downloads
    // both images each time.
    cacheDir     = '/ourdisk/hpc/lilab/babiddy/dont_archive/apptainer_cache'
}

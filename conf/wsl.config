// How a GPU-labelled process reaches a card under WSL2.

process {
    withLabel: 'gpu' {
        // --nv does not work under WSL2: libcuda.so needs its companions from /usr/lib/wsl/lib.
        // CONDA_PREFIX is empty in python_spatial, and cupy's CUDA header lookup keys off it.
        // TMPDIR repeated because this replaces nextflow.config's containerOptions.
        containerOptions = { '--bind /usr/lib/wsl' +
            ' --env LD_LIBRARY_PATH=/usr/lib/wsl/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64' +
            ' --env CONDA_PREFIX=/opt/conda/envs/python_spatial' +
            " --env TMPDIR=${task.workDir}" }
    }
}

// How a GPU-labelled process reaches a card under WSL2. Everything else comes from
// conf/defaults.config.

process {
    withLabel: 'gpu' {
        // --nv does not work under WSL2: the libcuda.so shim must load its companions from
        // /usr/lib/wsl/lib together to reach /dev/dxg.
        // CONDA_PREFIX because python_spatial does not export one -- it reads empty under
        // `apptainer exec` and cupy's CUDA header lookup keys off it, so every kernel compile
        // dies with "Failed to find CUDA headers". Comes out when the gpu label moves back to
        // python_gpu, which exports its own.
        // TMPDIR repeated because this replaces the containerOptions in the defaults.
        containerOptions = { '--bind /usr/lib/wsl' +
            ' --env LD_LIBRARY_PATH=/usr/lib/wsl/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64' +
            ' --env CONDA_PREFIX=/opt/conda/envs/python_spatial' +
            " --env TMPDIR=${task.workDir}" }
    }
}

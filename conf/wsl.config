// How a GPU-labelled process reaches a card under WSL2. A site's answer to `label 'gpu'`.
//
// Everything else — executor, paths, image — comes from conf/defaults.config, so this
// file states only what is different about being on WSL.

process {
    withLabel: 'gpu' {
        // Apptainer's --nv does not work under WSL2: the WSL libcuda.so shim must load its
        // companions from /usr/lib/wsl/lib together to reach /dev/dxg.
        // CONDA_PREFIX is deliberately not set here. cupy's CUDA header autodetection keys
        // off it, and the image sets it to its own env in %environment -- which a non-login
        // shell does get. Setting it here named python_spatial's path, so pointing the GPU
        // label at python_gpu sent cupy looking for headers in a directory that no longer
        // existed: "Failed to find CUDA headers".
        // TMPDIR repeated because this replaces the containerOptions in the defaults.
        containerOptions = { '--bind /usr/lib/wsl' +
            ' --env LD_LIBRARY_PATH=/usr/lib/wsl/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64' +
            " --env TMPDIR=${task.workDir}" }
    }
}

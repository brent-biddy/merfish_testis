// The defaults, applied unconditionally rather than as a `standard` profile: Nextflow only
// auto-applies `standard` when -profile is omitted, so `-profile wsl` would silently drop
// these. The cost is that a cluster run which forgets -profile oscer executes on the login
// node instead of failing.

params {
    // Beside the code: results/ is gitignored, reports/ is committed.
    work_root = "${System.getenv('HOME')}/merfish_testis_work"
    outdir    = "${projectDir}/results/${params.run_id}"
}

// Out of the repo: large, churny, and reproducible from the results tree. One dir per run,
// so a -stub run never shares an outdir with a real one.
workDir = "${params.work_root}/${params.run_id}"

// Dropped on success only, so resume-after-failure still works.
cleanup = true

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }

process {
    executor      = 'local'
    // An oras:// artifact is already a SIF, so there is no OCI-to-SIF conversion -- the step
    // that exceeds pullTimeout on a large image and is paid inside a job's wall clock.
    container     = 'oras://ghcr.io/brent-biddy/python_cpu-sif:1.0.0'
    cpus          = 4
    memory        = '16.GB'
    errorStrategy = 'finish'

    // The image is universal; how a site reaches a card is not, so that lives in site configs.
    //
    // On python_spatial while python_gpu cannot be pulled on OSCER (fails in under a second,
    // before any bytes move, mechanism unidentified). The cost is a docker:// URI, converted to
    // SIF on first pull -- what oscer.config's pullTimeout guards. Revert once the pull is
    // understood.
    withLabel: 'gpu' {
        container = 'docker://babiddy755/python_spatial:1.2.0'
    }

    // TMPDIR is unset inside the container, so scratch files land in the host's shared /tmp.
    // Point it at the task's own work dir instead.
    containerOptions = { "--env TMPDIR=${task.workDir}" }
}

apptainer {
    enabled    = true
    runOptions = '--writable-tmpfs'
    // A sibling of the per-run dirs: nested under workDir it would re-pull and re-convert
    // the image every run.
    cacheDir   = "${params.work_root}/apptainer_cache"
}

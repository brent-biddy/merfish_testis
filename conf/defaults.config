// The defaults. Applied unconditionally, not as a profile.
//
// There is deliberately no `standard` profile: Nextflow only auto-applies `standard` when
// -profile is omitted entirely, so `-profile wsl` would silently drop these settings along
// with it. Sitting outside every profile means a site profile states only its differences.
//
// The cost, stated plainly: a run on a cluster that forgets -profile oscer gets working
// local defaults, which means everything executes on the login node instead of failing.

params {
    // Beside the code: results/ is gitignored, reports/ is committed.
    work_root = "${System.getenv('HOME')}/merfish_testis_work"
    outdir    = "${projectDir}/results/${params.run_id}"
}

// Out of the repo: large, churny, and reproducible from the results tree. One dir per run,
// so a -stub run never shares an outdir with a real one.
workDir = "${params.work_root}/${params.run_id}"

// Dropped on success only, so resume-after-failure still works.
cleanup = true

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }

process {
    executor      = 'local'
    // The CPU image, as a ready-made SIF. An oras:// artifact is already in SIF format, so
    // Nextflow downloads it into cacheDir and runs it -- no OCI to SIF conversion, which is
    // the step that exceeds the 20 minute pullTimeout on a large image and is paid inside a
    // job's wall clock. Steps that need a GPU declare `label 'gpu'` and get the GPU image.
    container     = 'oras://ghcr.io/brent-biddy/python_cpu-sif:1.0.0'
    cpus          = 4
    memory        = '16.GB'
    errorStrategy = 'finish'

    // Which image carries the GPU stack is universal; how a site reaches a card is not. So the
    // image lives here and each site config adds only its own way of exposing the driver.
    //
    // Back on python_spatial while python_gpu cannot be pulled on OSCER -- an oras:// pull of it
    // there fails in under a second, before any bytes move, and the mechanism is not identified.
    // This image is already staged on OSCER and works, so the GPU step runs today at the cost of
    // being a docker:// URI: it is converted to SIF on first pull, which is what oscer.config's
    // pullTimeout guards. Move back to python_gpu once the pull is understood.
    withLabel: 'gpu' {
        container = 'docker://babiddy755/python_spatial:1.2.0'
    }

    // TMPDIR is unset inside the container, so scratch files land in the host's shared /tmp.
    // Point it at the task's own work dir instead.
    containerOptions = { "--env TMPDIR=${task.workDir}" }
}

apptainer {
    enabled    = true
    runOptions = '--writable-tmpfs'
    // A sibling of the per-run dirs: nested under workDir it would re-pull and re-convert
    // the image every run.
    cacheDir   = "${params.work_root}/apptainer_cache"
}

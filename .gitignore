# Data and outputs are never committed — they are reproducible from bin/ + assets/.
data/
results/
results_*/
work/

# Everything rendered lands in reports/, or in notebooks/ when rendered in place. The
# markdown and the figures beside it are committed, being the copy GitHub renders; the
# deck is not, being the same content in a format git has nothing useful to say about.
# Rebuild it by rendering. Scoped to where a render lands, so the template these are
# rendered from is committed by being an input rather than by an exception.
reports/**/*.pptx
notebooks/**/*.pptx

.nextflow/
.nextflow.log*

# Supplementary workbooks the reference CSVs were derived from; only the CSVs are read.
assets/reference/*.xlsx

# Quarto / Jupyter
*.quarto_ipynb
.quarto/
# Scoped to notebooks/, where rendering in place leaves one. The identically named
# directory under reports/ holds the figures a committed document links to.
notebooks/**/*_files/
.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
.venv/

manifest {
    name        = 'merfish_testis'
    description = 'Vizgen MERSCOPE (MERFISH) analysis of human testis'
    version     = '0.1.0'
    nextflowVersion = '>=23.0'
}

params {
    // Required: pipeline step to run. Valid values are steps.nf's valid_steps.
    step        = null

    // Required: path to a samplesheet CSV (columns vary by step — see steps.nf's header)
    samplesheet = null

    // create_centroids only: obs column to sum over. Null sweeps the leiden columns.
    group_by    = null

    // annotate_celltypes only: centroid CSV to correlate against. Null uses assets/reference.
    reference   = null

    // Render steps only, and required: the .qmd to render.
    qmd         = null

    // Render steps only: one of the formats the .qmd declares. Render twice for both.
    to          = 'pptx'

    // Names both dirs a run writes. Pin with --run_id for -resume across launches.
    //   results/20260901_153157/                 published beside the code
    //   ~/merfish_testis_work/20260901_153157/   work dir, or /scratch under -profile oscer
    run_id      = new java.text.SimpleDateFormat('yyyyMMdd_HHmmss').format(new Date())

    // Beside the code: results/ is gitignored, reports/ is committed.
    outdir      = "${projectDir}/results/${params.run_id}"
}

// Out of the repo, and one dir per run so a -stub run never shares an outdir with a real one.
workDir = "${System.getenv('HOME')}/merfish_testis_work/${params.run_id}"

// Dropped on success only, so resume-after-failure still works.
cleanup = true

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }

process {
    executor      = 'local'
    // An oras:// artifact is already a SIF, so the pull skips the OCI-to-SIF conversion.
    container     = 'oras://ghcr.io/brent-biddy/python_cpu-sif:1.0.0'
    cpus          = 4
    memory        = '16.GB'
    errorStrategy = 'finish'

    withLabel: 'gpu' {
        container = 'oras://ghcr.io/brent-biddy/python_gpu-sif:1.0.1'
    }

    // Nextflow forwards only the launching shell's TMPDIR, and a local run has none, so scratch
    // would land in the host's shared /tmp.
    containerOptions = { "--env TMPDIR=${task.workDir}" }
}

apptainer {
    enabled    = true
    runOptions = '--writable-tmpfs'
    // Shared across every repo on this machine, not just this one's workDir, so the same
    // image pulled for a different pipeline is reused rather than duplicated.
    cacheDir   = "${System.getenv('HOME')}/apptainer_cache"
}

// Forgetting -profile oscer runs the whole pipeline on the login node rather than failing.
// Adding a cluster is a copy of conf/oscer.config plus one line here.
profiles {
    wsl   { includeConfig 'conf/wsl.config'   }
    oscer { includeConfig 'conf/oscer.config' }
}

manifest {
    name        = 'merfish_testis'
    description = 'Vizgen MERSCOPE (MERFISH) analysis of human testis'
    version     = '0.1.0'
    nextflowVersion = '>=23.0'
}

params {
    // Timestamp id for this invocation. Pin it with --run_id for -resume across launches.
    run_id = new java.text.SimpleDateFormat('yyyyMMdd_HHmmss').format(new Date())

    // Root dir for a run's scratch: work dir and image cache. Results publish beside the
    // code instead. Set below, overridden by a site profile.
    work_root = null

    // Required: pipeline step to run. Valid values are steps.nf's valid_steps, which its
    // error message prints -- the dispatch block below it ends in a catch-all else.
    step        = null

    // Required: path to a samplesheet CSV (columns vary by step — see steps.nf's header)
    samplesheet = null

    // Set below, outside the profiles block, so this null is never seen.
    outdir      = null

    // create_centroids only: obs column to sum over. Null sweeps the leiden columns.
    group_by    = null

    // annotate_celltypes only: reference centroid CSV to correlate against. Null uses the
    // one committed in assets/reference.
    reference   = null

    // Render steps only, and required: the .qmd to render. A new report is a new notebook,
    // not a new module.
    notebook    = null

    // Render steps only: which of the formats the notebook declares to render. One format per
    // run -- render twice for both. pptx by default because it is gitignored, so an
    // exploratory render leaves nothing for git to pick up, and it is one file to copy off a
    // cluster; gfm is the committed copy, asked for deliberately.
    to          = 'pptx'
}

// Everything below applies unconditionally, rather than as a `standard` profile: Nextflow only
// auto-applies `standard` when -profile is omitted, so `-profile wsl` would silently drop these.
// The cost is that a cluster run which forgets -profile oscer executes on the login node
// instead of failing.

params {
    // Beside the code: results/ is gitignored, reports/ is committed.
    work_root = "${System.getenv('HOME')}/merfish_testis_work"
    outdir    = "${projectDir}/results/${params.run_id}"
}

// Dropped on success only, so resume-after-failure still works.
cleanup = true

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }

process {
    executor      = 'local'
    // An oras:// artifact is already a SIF, so the pull skips the OCI-to-SIF conversion --
    // the step that exceeds pullTimeout on a large image, paid inside a job's wall clock.
    container     = 'oras://ghcr.io/brent-biddy/python_cpu-sif:1.0.0'
    cpus          = 4
    memory        = '16.GB'
    errorStrategy = 'finish'

    // The image is universal; how a site reaches a card is not, so that lives in site configs.
    //
    // On python_spatial while python_gpu cannot be pulled on OSCER (fails in under a second,
    // before any bytes move, mechanism unidentified). The cost is a docker:// URI, converted to
    // SIF on first pull -- what oscer.config's pullTimeout guards. Revert once the pull is
    // understood.
    withLabel: 'gpu' {
        container = 'docker://babiddy755/python_spatial:1.2.0'
    }

    // Apptainer keeps only the TMPDIR Nextflow forwards from the launching shell: unset on a
    // local run, so scratch lands in the host's shared /tmp, and a job-scoped one under SLURM.
    // Point it at the task's own work dir either way.
    containerOptions = { "--env TMPDIR=${task.workDir}" }
}

apptainer {
    enabled    = true
    runOptions = '--writable-tmpfs'
    // A sibling of the per-run dirs: nested under workDir it would re-pull and re-convert
    // the image every run.
    cacheDir   = "${params.work_root}/apptainer_cache"
}

// Sites: executor, scratch and cache paths, and how a `label 'gpu'` process reaches a card.
// Adding a cluster is a copy of conf/oscer.config plus one line here -- no module is touched.
profiles {
    wsl   { includeConfig 'conf/wsl.config'   }
    oscer { includeConfig 'conf/oscer.config' }
}

// Out of the repo: large, churny, and reproducible from the results tree. One dir per run,
// so a -stub run never shares an outdir with a real one.
//
// Below the profiles on purpose, and it must stay there: the interpolation is eager, so a
// site that sets work_root gets scratch here only if this line is read after it. Moving it up
// would leave every site scratching to $HOME. That does not generalise to cacheDir above --
// oscer sets its own, which a line down here would clobber.
workDir = "${params.work_root}/${params.run_id}"

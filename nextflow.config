manifest {
    name        = 'merfish_testis'
    description = 'Vizgen MERSCOPE (MERFISH) analysis of human testis'
    version     = '0.1.0'
    nextflowVersion = '>=23.0'
}

params {
    // Timestamp id for this invocation. Pin it with --run_id for -resume across launches.
    run_id = new java.text.SimpleDateFormat('yyyyMMdd_HHmmss').format(new Date())

    // Root dir for a run's scratch: the work dir and the image cache. Results are not
    // under it — they publish beside the code. Set in conf/defaults.config; a site
    // profile overrides it to point at that cluster's scratch.
    work_root = null

    // Required: pipeline step to run. Valid values are steps.nf's dispatch block.
    step        = null

    // Required: path to a samplesheet CSV (columns vary by step — see steps.nf's header)
    samplesheet = null

    // Declared here, set in conf/defaults.config to <project>/results/<run_id>. Those
    // defaults apply unconditionally, so this null is never what a run sees.
    outdir      = null

    // create_centroids only: obs column to sum over. Null sweeps the leiden columns.
    // A run with it set publishes under its own names, beside the sweep's.
    group_by    = null

    // annotate_celltypes only: reference centroid CSV to correlate against. Null uses the
    // one committed in assets/reference.
    reference   = null

    // Render steps only: the .qmd to render. Required by them, as they have no notebook of
    // their own -- a new report is a new notebook here, not a new module.
    notebook    = null

    // Render steps only: render just one of the formats the notebook declares, rather than
    // all of them. Null renders every declared format in one pass.
    to          = null

    // Render steps only: names the directory a render publishes into under reports/. Null
    // uses <notebook>_<run_id>, so an unnamed render cannot displace an earlier one. Naming
    // one gives that up: two runs sharing a report_id and format publish into one directory.
    report_id   = null
}

// The defaults, applied unconditionally rather than as a `standard` profile — see the note at
// the top of conf/defaults.config for why.
includeConfig 'conf/defaults.config'

// Sites. Each answers the same questions its own way: which executor, where scratch and the
// image cache live, and how a `label 'gpu'` process reaches a card. Pick one.
//
// A collaborator adds their cluster by copying conf/oscer.config, changing the paths and queue
// names, and adding one line here. No module, script or process is touched.
profiles {
    wsl   { includeConfig 'conf/wsl.config'   }
    oscer { includeConfig 'conf/oscer.config' }
}

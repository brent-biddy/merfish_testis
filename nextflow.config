manifest {
    name        = 'merfish_testis'
    description = 'Vizgen MERSCOPE (MERFISH) analysis of human testis'
    version     = '0.1.0'
    nextflowVersion = '>=23.0'
}

params {
    // Timestamp id for this invocation. Pin it with --run_id for -resume across launches.
    run_id = new java.text.SimpleDateFormat('yyyyMMdd_HHmmss').format(new Date())

    // Root dir for a run's scratch: work dir and image cache. Results publish beside the
    // code instead. Set in conf/defaults.config, overridden by a site profile.
    work_root = null

    // Required: pipeline step to run. Valid values are steps.nf's dispatch block.
    step        = null

    // Required: path to a samplesheet CSV (columns vary by step — see steps.nf's header)
    samplesheet = null

    // Set in conf/defaults.config, which applies unconditionally -- this null is never seen.
    outdir      = null

    // create_centroids only: obs column to sum over. Null sweeps the leiden columns.
    group_by    = null

    // annotate_celltypes only: reference centroid CSV to correlate against. Null uses the
    // one committed in assets/reference.
    reference   = null

    // Render steps only, and required: the .qmd to render. A new report is a new notebook,
    // not a new module.
    notebook    = null

    // Render steps only: one of the formats the notebook declares. Empty renders all of them.
    // Empty rather than null: it reaches QUARTO_RENDER as a `val` input, which cannot be null.
    to          = ''
}

// The defaults, applied unconditionally rather than as a `standard` profile — see the note at
// the top of conf/defaults.config for why.
includeConfig 'conf/defaults.config'

// Sites: executor, scratch and cache paths, and how a `label 'gpu'` process reaches a card.
// Adding a cluster is a copy of conf/oscer.config plus one line here -- no module is touched.
profiles {
    wsl   { includeConfig 'conf/wsl.config'   }
    oscer { includeConfig 'conf/oscer.config' }
}

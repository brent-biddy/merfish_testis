manifest {
    name        = 'merfish_testis'
    description = 'Vizgen MERSCOPE (MERFISH) analysis of human testis'
    version     = '0.1.0'
    nextflowVersion = '>=23.0'
}

params {
    // Timestamp id for this invocation. Pin it with --run_id for -resume across launches.
    run_id = new java.text.SimpleDateFormat('yyyyMMdd_HHmmss').format(new Date())

    // Root dir for a run's scratch: the work dir and the image cache. Results are not
    // under it — they publish beside the code. Set by the profile.
    work_root = null

    // Required: pipeline step to run. Valid values are main.nf's dispatch block.
    step        = null

    // Required: path to a samplesheet CSV (columns vary by step — see main.nf's header)
    samplesheet = null

    // Set by the profile to <project>/results/<run_id>. Null here so a run without a
    // profile fails on a visibly broken path rather than publishing somewhere arbitrary.
    outdir      = null

    // create_centroids only: obs column to sum over. Null sweeps the leiden columns.
    // A run with it set publishes under its own names, beside the sweep's.
    group_by    = null

    // annotate_celltypes only: reference centroid CSV to correlate against. Null uses the
    // one committed in assets/reference.
    reference   = null
}

profiles {
    // Named `local`, not `standard`: Nextflow auto-applies a `standard` profile when
    // -profile is omitted, so a run without -profile gets no container and no executor.
    local {
        // params first — workDir, cacheDir and the report blocks below all read them.
        params {
            work_root = "${System.getenv('HOME')}/merfish_testis_work"
            // Beside the code: results/ is gitignored, reports/ is committed.
            outdir    = "${projectDir}/results/${params.run_id}"
        }

        // Out of the repo: large, churny, and reproducible from the results tree.
        // One dir per run, so a -stub run never shares an outdir with a real one.
        workDir = "${params.work_root}/${params.run_id}"

        // Dropped on success only, so resume-after-failure still works.
        cleanup = true

        // In the profile so params.outdir resolves to this profile's value.
        timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
        report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }
        process {
            executor      = 'local'
            container     = 'babiddy755/python_spatial:1.2.0'
            cpus          = 4
            memory        = '16.GB'
            errorStrategy = 'finish'

            // TMPDIR is unset inside the container, so scratch files land in the host's
            // shared /tmp. Point it at the task's own work dir instead.
            containerOptions = { "--env TMPDIR=${task.workDir}" }

            withName: 'CLUSTER_SPATIALDATA_GPU' {
                // Apptainer's --nv does not work under WSL2: the WSL libcuda.so shim must
                // load its companions from /usr/lib/wsl/lib together to reach /dev/dxg.
                // CONDA_PREFIX is required too — cupy's CUDA header autodetection keys off
                // it, and the non-login shell `script:` uses never sets it.
                // TMPDIR repeated because this replaces the containerOptions above.
                containerOptions = { '--bind /usr/lib/wsl' +
                    ' --env LD_LIBRARY_PATH=/usr/lib/wsl/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64' +
                    ' --env CONDA_PREFIX=/opt/conda/envs/python_spatial' +
                    " --env TMPDIR=${task.workDir}" }
            }
        }
        apptainer {
            enabled    = true
            runOptions = '--writable-tmpfs'
            // A sibling of the per-run dirs: nested under workDir it would re-pull and
            // re-convert the image every run.
            cacheDir   = "${params.work_root}/apptainer_cache"
        }
    }

    // Three filesystems, by what each holds. The repo lives on OURdisk (permanent, large)
    // and publishes results beside its own code. Scratch takes the work dir alone: it is
    // the large compute-node-accessible one, but files there are deleted 14 days after
    // creation regardless of use, so nothing durable can sit on it. Home is small and not
    // meant for pipeline I/O at all.
    oscer {
        params {
            work_root = "/scratch/${System.getenv('USER')}/merfish_testis_work"
            outdir    = "${projectDir}/results/${params.run_id}"
        }
        workDir = "${params.work_root}/${params.run_id}"
        cleanup = true

        timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
        report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }
        process {
            executor      = 'slurm'
            queue         = 'normal'
            container     = 'babiddy755/python_spatial:1.2.0'
            cpus          = 8
            // Scales with the attempt so a task that died on memory gets more.
            memory        = { 32.GB * task.attempt }
            time          = { 4.h + (task.attempt - 1) * 4.h }
            errorStrategy = 'retry'
            maxRetries    = 3

            // TMPDIR is unset inside the container — the `env -` Nextflow wraps around
            // apptainer drops the job-scoped one SLURM sets — so scratch files land in the
            // node's shared /tmp. Point it at the task's own work dir instead.
            containerOptions = { "--env TMPDIR=${task.workDir}" }

            // --gres is what actually allocates a card; --nv exposes the driver inside the
            // container. CONDA_PREFIX is required because cupy JIT-compiles kernels and
            // finds the CUDA headers under it, and the shell `script:` uses never sets it.
            withName: 'CLUSTER_SPATIALDATA_GPU' {
                // Any GPU rather than an H100 specifically. The step asks for one card and
                // never uses NVlink, so pinning H100 buys only its 80 GB over the 48 GB of
                // the Ada and L40S cards in this partition -- while narrowing what can
                // schedule it. A b2_r0 sweep on sooner_gpu_test_h100 pended 71 minutes to
                // run for 7.
                queue            = 'sooner_gpu_test'
                clusterOptions   = '--gres=gpu:1'
                // TMPDIR repeated because this replaces the containerOptions above.
                containerOptions = { '--nv --env CONDA_PREFIX=/opt/conda/envs/python_spatial' +
                    " --env TMPDIR=${task.workDir}" }
            }
        }
        apptainer {
            enabled      = true
            runOptions   = '--writable-tmpfs'
            // Nextflow's launcher wraps apptainer exec in `env -`, which drops the variable
            // SLURM sets to name the allocated GPU. Without it cupy takes device 0, which
            // may be another job's card, and dies out of memory while the allocated one idles.
            envWhitelist = 'CUDA_VISIBLE_DEVICES'
            // On OURdisk rather than under work_root: scratch's 14-day delete runs on
            // creation time, so a cache there is dropped every fortnight and pays the
            // conversion below again each time.
            cacheDir     = '/ourdisk/hpc/lilab/babiddy/dont_archive/apptainer_cache'
            // The OCI to SIF conversion of this image exceeds the 20m default, which
            // kills it mid-conversion with exit 143.
            pullTimeout  = '2h'
        }
    }
}
